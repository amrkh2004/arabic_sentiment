      "title": "Inference Request Rate (RPS)",
      "type": "stat",
      "targets": [
        { "expr": "sum(rate(arabic_sentiment_requests_total[1m]))", "legendFormat": "RPS" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.20 }] } }
      },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "options": { "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "p95 Latency SLA (Threshold: 200ms)",
      "type": "stat",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(arabic_sentiment_latency_seconds_bucket[1m])) by (le))", "legendFormat": "p95 Latency" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } }
