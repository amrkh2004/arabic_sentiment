      "title": "Sentiment Distribution (Positive / Negative / Neutral)",
      "type": "piechart",
      "targets": [
        { "expr": "sum by (sentiment) (arabic_sentiment_predictions_total)", "legendFormat": "{{ sentiment }}", "instant": true }
      ]
